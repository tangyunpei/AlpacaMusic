# SwiftPM, Xcode and local build output
/.build/
/.swiftpm/
/build/
/DerivedData/

# macOS and developer-specific IDE state
.DS_Store
._*
*.xcuserstate
xcuserdata/
*.xccheckout
*.xcscmblueprint

# Local signing configuration and environment values
signing.local.plist
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private signing keys and provisioning exports
*.p8
*.p12
*.pfx
*.key
*.pem
*.mobileprovision
*.provisionprofile

# Packaged applications, installers and debug archives
*.app/
*.dmg
*.pkg
*.xcarchive/
