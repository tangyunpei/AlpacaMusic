/AlpacaMusic-*.zip

# Local diagnostics and coverage output
*.log
*.xcresult/
*.crash
*.ips
*.profraw
*.profdata
/notary-*.json
/notarization-*.json

# Personal library exports and local credential dumps
library-v1*.json
cookies.local.*
credentials.local.*

# Python cache and local environments used by build scripts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
